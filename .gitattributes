# Every text file is stored and checked out with LF line ends, on every platform: the records and the page
# are hashed, and a hash must not depend on who wrote the file.
* text=auto eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
